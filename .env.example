# Copy to .env and chmod 600 .env. Never commit .env (it is in .gitignore).
# Leave PayPal vars empty to run against the built-in MOCK PayPal backend.
# Sandbox only: the client refuses any host other than api-m.sandbox.paypal.com.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Optional: Claude as the planner. Empty = deterministic offline mock planner.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Sandbox purchase demo: one of your sandbox *business* account emails (the supplier/payee).
COUNTERSIGN_SUPPLIER_EMAIL=
